DATABASE_SERVER=localhost
DATABASE_NAME=mydb
DATABASE_USER=sa
DATABASE_PASSWORD=yourpassword
DATABASE_PORT=1433
DEBUG=True

# LLM configuration — comma-separated list of service:model[@provider_hint]
# service = anthropic | groq | openrouter
# provider_hint (openrouter only) = preferred underlying provider, e.g. @Together
# At least one entry required. Tried in order; falls through to next on error.
# Examples:
#   anthropic:claude-sonnet-4-6
#   anthropic:claude-opus-4-7,anthropic:claude-sonnet-4-6
#   groq:llama-3.3-70b-versatile,openrouter:anthropic/claude-3-5-sonnet@Together
LLM_MODELS=anthropic:claude-sonnet-4-6

ANTHROPIC_API_KEY=your_anthropic_key
GROQ_API_KEY=your_groq_key
OPENROUTER_API_KEY=your_openrouter_key

# Show template description in the Reasoning tab (default: false)
SHOW_TEMPLATE_DESCRIPTION=false

# MCP API keys — comma-separated bearer tokens for /mcp endpoint auth (Claude Desktop / Claude Code)
# Leave empty to disable auth (local/dev use only)
# Generate with: python3 -c "import secrets; print('wai_' + secrets.token_hex(32))"
MCP_API_KEYS=

# OAuth2 client credentials for /mcp endpoint (claude.ai web)
# Format: comma-separated client_id:client_secret pairs
# Example: MCP_OAUTH_CLIENTS=claude_ai:mysecret,otherapp:anothersecret
MCP_OAUTH_CLIENTS=

# JWT signing secret — required when MCP_OAUTH_CLIENTS is set
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
MCP_JWT_SECRET=

# JWT token expiry in seconds (default: 3600 = 1 hour)
MCP_JWT_EXPIRY_SECONDS=3600

# Single SQL Server schema to introspect — multiple schemas are not supported
DATABASE_SCHEMA=dbo

# Schema filtering (all optional, combinable)
# Only include tables whose name contains this substring (case-insensitive)
TABLE_KEY_FILTER=
# Comma-separated explicit list of table names to include
TABLE_WHITELIST=
# Comma-separated blacklist — always excluded, even if matched by filter/whitelist
TABLE_EXCEPTION_LIST=
